# ============================================================
#  .env — Konfigurasi PoC TKI Super Apps Integration
#  JANGAN commit file ini ke Git
#  JANGAN biarkan bisa diakses via browser
# ============================================================

# ── TKI / Super Apps (dari tim Solusi Negeri) ───────────────
TKI_VALIDATE_URL=https://api.stg.solusinegeri.com/gateway/api/authentication/one-time-access-token_with_auth/validate
TKI_BASE_URL=https://api.stg.solusinegeri.com
TKI_API_KEY=GANTI_DENGAN_API_KEY_DARI_SOLUSI_NEGERI
TKI_COMPANY_ID=GANTI_DENGAN_COMPANY_ID_UNHAS

# ── Aplikasi Dummy ───────────────────────────────────────────
# URL lengkap halaman dashboard dummy app Anda
DUMMY_APP_URL=https://GANTI_DOMAIN_DUMMY_APP/dashboard.php

# Nama aplikasi (tampil di halaman error)
APP_NAME=Dummy App PoC Unhas

# Environment: sandbox | staging | production
APP_ENV=sandbox

# ── Cookie ───────────────────────────────────────────────────
# Kosongkan jika redirect dan dummy app di domain yang sama
# Isi dengan .yourdomain.com jika beda subdomain
COOKIE_DOMAIN=

# Durasi cookie dalam detik (3600 = 1 jam)
COOKIE_TTL=3600
